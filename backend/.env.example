# ===========================
# QueryMind Backend - Environment Variables
# ===========================

# ----- Application -----
APP_NAME=QueryMind
APP_ENV=development
DEBUG=True

# ----- Database (PostgreSQL) -----
DATABASE_URL=postgresql+asyncpg://querymind:querymind_dev@localhost:5432/querymind

# ----- Qdrant (Vector Database) -----
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_DOCUMENTS=querymind_documents
QDRANT_COLLECTION_MEMORIES=querymind_memories

# ----- Supabase Auth -----
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# ----- Google Gemini API -----
GEMINI_API_KEY=your_gemini_api_key_here

# ----- File Upload -----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ----- CORS -----
FRONTEND_URL=http://localhost:3000
